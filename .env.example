DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="generate-a-random-secret-here"

# Where pitchr-ai (the AI service) runs. Defaults to http://localhost:8000
PITCHR_AI_URL="http://localhost:8000"

# Shared secret sent to pitchr-ai. Must match PITCHR_AI_API_KEY in pitchr-ai's .env
PITCHR_AI_API_KEY="generate-a-random-secret-here"
