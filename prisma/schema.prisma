// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id    String   @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  firstName   String
  lastName    String
  email   String  @unique
  password    String
  role    Role
  touchPoints   TouchPoint[]
  notes   Note[]
  assignedLeads Lead[]    @relation("LeadAssignment")
  contactsOwned       Contact[]            @relation("ContactOwner")
  stageChanges        LeadStageChange[]
  outreachSessions    OutreachSession[]
}

enum Role {
  STAFF
  ADMIN
}

model Lead {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    String

  locations Location[]
  // Primary location reference (nullable if not set yet)
  primaryLocation   Location?   @relation("PrimaryLocation", fields: [primaryLocationId], references: [id])
  primaryLocationId   String?   @unique

  contacts  Contact[]

  industry    Industry    @relation(fields: [industryId], references: [id])
  industryId    String
  businessType    BusinessType    @relation(fields: [businessTypeId], references: [id])
  businessTypeId    String

  igHandle    String?
  igFollowerCount   Int?

  email   String?
  website   String?

  pipelineStage   PipelineStage   @default(NEW)
  source          LeadSource?
  discoveredVia   DiscoveredVia?
  discoveredViaOther  String?
  convertedAt     DateTime?

  isBlackOwned    Boolean   @default(false)
  isWomanOwned    Boolean   @default(false)
  isLatinoOwned   Boolean   @default(false)
  isImmigrantOwned    Boolean   @default(false)

  touchPoint    TouchPoint[]
  notes   Note[]
  tasks         Task[]
  attachments   Attachment[]
  signals       Signal[]
  stageChanges  LeadStageChange[]
  sessionItems  SessionItem[]
  priority    Priority?

  sequenceStep    Int     @default(0)
  sequenceActive  Boolean @default(false)
  isHot           Boolean @default(false)
  noInPersonContact Boolean @default(false)

  dormantReason     String?
  dormantRevisitAt  DateTime?

  assignedTo    User?    @relation("LeadAssignment", fields: [assignedToId], references: [id])
  assignedToId  String?

  referredByLead    Lead?    @relation("LeadReferrals", fields: [referredByLeadId], references: [id])
  referredByLeadId  String?
  referredByName    String?
  referrals         Lead[]   @relation("LeadReferrals")

  instagramHandle   String?
  instagramFollowers Int?
  tiktokHandle      String?
  tiktokFollowers   Int?
  youtubeHandle     String?
  youtubeFollowers  Int?
  facebookHandle    String?
  facebookFollowers Int?
}

model Contact {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firstName       String
  lastName        String?
  title           String?   // e.g. "Owner", "Director of Marketing"
  email           String?
  phone           String?
  isDecisionMaker Boolean  @default(false)
  bio             String?

  howWeMet        ContactSource?
  howWeMetNote    String?
  lastContactedAt DateTime?

  lead        Lead?        @relation(fields: [leadId], references: [id])
  leadId      String?
  touchPoints TouchPoint[]

  user        User?        @relation("ContactOwner", fields: [userId], references: [id])
  userId      String?

  tasks       Task[]
  touchpoints TouchPoint[] @relation("ContactTouchPoints")
  notes       Note[]
  attachments Attachment[]
}

model Industry {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  name    String  @unique 

  leads   Lead[]
}

model BusinessType {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  name    String  @unique
  leads   Lead[]
}

model Location {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Lead    @relation(fields: [businessId], references: [id])
  businessId    String

  addressLine1    String
  addressLine2   String?
  city    String
  state   String
  zip   String

  phoneNumbers    PhoneNumber[]

  // Optional reverse relation to know if this location is primary
  primaryForBusiness    Lead?   @relation("PrimaryLocation")
}

model PhoneNumber {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  number    String
  label   PhoneType?

  location    Location? @relation(fields: [locationId], references: [id])
  locationId    String?
}

model Note {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  text    String

  lead    Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?

  contact   Contact?  @relation(fields: [contactId], references: [id])
  contactId String?

  author    User    @relation(fields: [userId], references: [id])
  userId    String
}

model TouchPoint {
  id    String  @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  date    DateTime
  type    TouchPointType

  lead    Lead?   @relation(fields: [leadId], references: [id])
  leadId  String?

  contact   Contact? @relation("ContactTouchPoints", fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  contactedBy   User?   @relation(fields: [contactedById], references: [id])
  contactedById String?

  receivedResponse    Boolean   @default(false)
  summary   String?

  // Outreach sessions. In person and calls record an outcome at the time;
  // DMs, emails and texts record delivery at the time and a response later.
  session       OutreachSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId     String?
  sessionItem   SessionItem?
  outcome       TouchPointOutcome?
  delivery      TouchPointDelivery?
  response      TouchPointResponse?
  // Set when the outcome or response is "has a provider"
  providerType  ProviderType?
  // Entered by hand, date only (defaults to the day it's recorded)
  respondedOn   DateTime?           @db.Date
  leftMaterials Boolean             @default(false)
  // "Come back later": when they said to come back, if they named a time
  comeBackAt    DateTime?

  sequencePosition    SequencePosition?

  tasks       Task[]
  attachments Attachment[]
  contacts    Contact[]
}

model Attachment {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])

  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])

  touchpointId String?
  touchpoint   TouchPoint? @relation(fields: [touchpointId], references: [id])

  url         String
  key         String
  filename    String
  mimeType    String
  size        Int
  caption     String?
}

enum SequencePosition {
  VISIT_A
  A1
  A2
  A3
  VISIT_B
  B1
  B2
  B3
  VISIT_C
  C1
  C2
  C3
}

enum PipelineStage {
  NEW
  CONTACTED
  ENGAGED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  CONVERTED
  DORMANT
  NOT_A_FIT
  LOST
}

enum LeadSource {
  OUTREACH
  REFERRAL
  FORM
  NETWORKING
  IN_PERSON
}

enum ContactSource {
  OUTREACH
  REFERRAL
  FORM
  NETWORKING
  IN_PERSON
  OTHER
}

enum DiscoveredVia {
  OUTREACH
  REFERRAL
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  GOOGLE
  NETWORKING
  IN_PERSON
  OTHER
}

enum Priority {
  ONE 
  TWO
  THREE
}

// Interest a lead showed on their own, without us reaching out (vs. TouchPoint, which is our outreach).
enum SignalType {
  FOLLOW
  POST_ENGAGEMENT
  DIRECT_MESSAGE
  WEBSITE_FORM
  REFERRAL
}

// Where a social signal happened. Null for non-social signals (website form, referral).
enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  LINKEDIN
  OTHER
}

enum TouchPointType {
  EMAIL
  INSTAGRAM_DM
  CALL
  TEXT
  IN_PERSON
  MEETING
  VISIT_ATTEMPT
  NETWORKING
  WALK_UP
  REFERRAL_OUTREACH
  OTHER
}

enum PhoneType {
  MOBILE
  OFFICE
  HOME
}

model Task {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lead        Lead?          @relation(fields: [leadId], references: [id])
  leadId      String?

  contact     Contact?       @relation(fields: [contactId], references: [id])
  contactId   String?

  touchPoint   TouchPoint?   @relation(fields: [touchPointId], references: [id])
  touchPointId String?

  type        TouchPointType
  dueDate     DateTime?
  note        String?

  completed        Boolean        @default(false)
  completedAt      DateTime?

  isCheckIn        Boolean        @default(false)
  isResponseCheck  Boolean        @default(false)
  isEmailSentCheck Boolean        @default(false)

  @@map("Reminder")
}

model Signal {
  id          String     @id @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String

  type        SignalType
  platform    SocialPlatform?
  date        DateTime
  note        String?
}

// Every change to a lead's pipeline stage, with who made it and when.
// fromStage is null for the lead's first stage (when it was created).
model LeadStageChange {
  id          String         @id @default(uuid())

  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String

  fromStage   PipelineStage?
  toStage     PipelineStage

  // Null when the system made the change (e.g. a sequence ending in Dormant)
  changedBy   User?          @relation(fields: [changedById], references: [id])
  changedById String?

  changedAt   DateTime       @default(now())

  @@index([leadId, changedAt])
}

// ── Outreach sessions ────────────────────────────────────────────────────────

// How outreach is done in a session; sets the default type for its touchpoints.
enum SessionChannel {
  IN_PERSON
  CALL
  INSTAGRAM_DM
  EMAIL
  TEXT
  MIXED
}

enum SessionItemStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

// In person and calls: what happened, recorded at the time
enum TouchPointOutcome {
  BUSINESS_CLOSED
  NO_ANSWER
  LEFT_VOICEMAIL
  DECISION_MAKER_NOT_AVAILABLE
  COME_BACK_LATER
  INTERESTED
  NOT_INTERESTED
  HAS_PROVIDER
  NOT_A_FIT
  MEETING_BOOKED
}

// DMs, emails, texts: whether the message got through, recorded at the time
enum TouchPointDelivery {
  SENT
  FAILED
}

// DMs, emails, texts: how they responded. PENDING until we know.
enum TouchPointResponse {
  PENDING
  INTERESTED
  COME_BACK_LATER
  NOT_INTERESTED
  HAS_PROVIDER
  NOT_A_FIT
  MEETING_BOOKED
  NO_RESPONSE
}

enum ProviderType {
  VIDEO
  MARKETING_AGENCY
  UNKNOWN
}

// A block of outreach work by one person (a route, an hour of DMs, a batch of emails).
// Planned: plannedFor set, not started. In progress: startedAt set. Ended: endedAt set.
model OutreachSession {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  userId      String

  channel     SessionChannel
  plannedFor  DateTime?       @db.Date
  startedAt   DateTime?
  endedAt     DateTime?
  area        String?
  // e.g. 20 (stops, DMs...)
  goal        Int?
  notes       String?

  items       SessionItem[]
  touchPoints TouchPoint[]

  @@index([userId, plannedFor])
}

// One lead on a session's list. Planned before anything happens; completed when
// its touchpoint is logged; skipped if we decided not to contact them.
model SessionItem {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  session      OutreachSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String

  lead         Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String

  // Order in the session (0, 1, 2...)
  position     Int
  // Set by "come back later today"
  plannedTime  DateTime?
  status       SessionItemStatus @default(PLANNED)

  // The touchpoint this item produced, once logged
  touchPoint   TouchPoint?       @relation(fields: [touchPointId], references: [id], onDelete: SetNull)
  touchPointId String?           @unique

  @@index([sessionId, position])
}
